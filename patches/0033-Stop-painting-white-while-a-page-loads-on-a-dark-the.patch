From a44afc25448b181b0517793c34104fe5545c9cc9 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Tue, 18 Aug 2026 16:20:53 +0000
Subject: [PATCH] Stop painting white while a page loads on a dark theme

On a dark theme every navigation showed a white flash before the page appeared, which is
glaring on an OLED screen at night. Screen recordings measured it at a peak brightness of
214 out of 255 held for about 0.6 seconds. Three separate surfaces painted white, and each
is addressed here.

ThemeUtils.getBackgroundColor now prefers the themed default while a tab is loading. The
themed fallback was already present below, but it was unreachable: the render widget
reports an opaque white during load rather than transparent, so the check for transparent
never passed and the white was handed to the compositor. Recording the same navigation
after the change measured a peak of 44 with no frames bright enough to register.

TabAndroid::InitWebContents sets the page base background to black in night mode. This is
the colour the renderer fills with before a page paints its own background. Verified with a
page whose response stalls midway and declares no background: it now holds dark instead of
white.

CompositorViewHolder.prepareForTabReparenting uses the theme colour rather than a hardcoded
white for the placeholder shown before the first buffer swap.

The remaining flash after those three is the page itself: a light site genuinely paints its
own white background, and stays white until an extension such as Dark Reader restyles it,
which takes a few hundred milliseconds. Blink can darken from the first paint instead, but
the setting that controls it sits behind DarkenWebsitesCheckboxInThemesSetting, which
upstream disables, so the option never appears and the feature is unreachable. Enabling it
puts "Apply dark theme to sites, when possible" in Settings > Theme. The opt_out parameter
is set to false so the content setting still defaults to BLOCK and nothing darkens until
the user ticks the box; upstream true would have turned it on for everybody.
Migration note (8010.27): the ThemeUtils.getBackgroundColor hunk is dropped. Upstream rewrote the method to read tab.getBackgroundColor(), which is fed by WebContents.onBackgroundColorChanged and falls back to the theme colour while transparent, so the render widget path this hunk worked around is gone. The features.cc comment now describes the flag as the auto-dark toggle rather than a white-flash fix, because the flash happens before the page paints. The tab_android.cc hunk keeps SK_ColorBLACK: following the selected theme colour would need a themed Context reachable from native code, which patch 0077 showed to be the unreliable part, and the white-flash comparison on device comes first.
---
 .../browser/compositor/CompositorViewHolder.java  | 10 +++++++---
 chrome/browser/android/tab_android.cc             | 15 +++++++++++++++
 .../content_settings/core/common/features.cc      | 15 +++++++++++++--
 3 files changed, 35 insertions(+), 5 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java b/chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java
index a01a69c7fe..be3752159a 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java
@@ -18,7 +18,6 @@ import static java.util.Collections.emptySet;
 
 import android.app.Activity;
 import android.content.Context;
-import android.graphics.Color;
 import android.graphics.Point;
 import android.graphics.Rect;
 import android.graphics.RectF;
@@ -96,6 +95,7 @@ import org.chromium.chrome.browser.ui.side_ui.SideUiCoordinator.SideUiSpecs;
 import org.chromium.chrome.browser.ui.side_ui.SideUiObserver;
 import org.chromium.chrome.browser.ui.side_ui.SideUiStateProvider;
 import org.chromium.chrome.browser.ui.vertical_tabs.VerticalTabUtils;
+import org.chromium.components.browser_ui.styles.ChromeColors;
 import org.chromium.components.browser_ui.widget.TouchEventObserver;
 import org.chromium.components.browser_ui.widget.TouchEventProvider;
 import org.chromium.components.content_capture.OnscreenContentProvider;
@@ -863,9 +863,13 @@ public class CompositorViewHolder extends FrameLayout
     public void prepareForTabReparenting() {
         if (mHasDrawnOnce) return;
 
-        // Set the background to white while we wait for the first swap of buffers. This gets
+        // Set a placeholder background while we wait for the first swap of buffers. This gets
         // corrected inside the view.
-        mCompositorView.setBackgroundColor(Color.WHITE);
+        //
+        // De-Googled build: follow the theme rather than always using white, which flashed on a
+        // dark theme.
+        mCompositorView.setBackgroundColor(
+                ChromeColors.getPrimaryBackgroundColor(getContext(), false));
     }
 
     @Override
diff --git a/chrome/browser/android/tab_android.cc b/chrome/browser/android/tab_android.cc
index ec48143154..cdd925b459 100644
--- a/chrome/browser/android/tab_android.cc
+++ b/chrome/browser/android/tab_android.cc
@@ -86,6 +86,7 @@
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_observer.h"
 #include "content/public/browser/web_contents_user_data.h"
+#include "third_party/skia/include/core/SkColor.h"
 #include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
 #include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
 #include "ui/android/view_android.h"
@@ -360,6 +361,20 @@ void TabAndroid::InitWebContents(
 
   night_mode::WebContentsThemeClient::CreateForWebContents(web_contents_.get());
 
+  // De-Googled build: paint the pre-paint background black in night mode.
+  //
+  // Before a page paints its own background the renderer fills with its base colour, which
+  // defaults to white. On a dark theme that produces a white flash on every navigation, which
+  // is glaring on an OLED screen at night.
+  //
+  // The theme client created just above already answers whether night mode is on, so the colour
+  // follows the user theme rather than being forced. In light mode nothing is set and the
+  // default white is kept.
+  if (night_mode::WebContentsThemeClient::FromWebContents(web_contents_.get())
+          ->IsNightModeEnabled()) {
+    web_contents_->SetPageBaseBackgroundColor(SK_ColorBLACK);
+  }
+
   renderer_preferences_util::UpdateFromSystemSettings(
       web_contents_->GetMutableRendererPrefs(),
       Profile::FromBrowserContext(web_contents_->GetBrowserContext()));
diff --git a/components/content_settings/core/common/features.cc b/components/content_settings/core/common/features.cc
index 088951616f..0bb3a171a4 100644
--- a/components/content_settings/core/common/features.cc
+++ b/components/content_settings/core/common/features.cc
@@ -11,10 +11,21 @@ namespace content_settings {
 
 // Enables auto dark feature in theme settings.
 #if BUILDFLAG(IS_ANDROID)
+// De-Googled build: enabled so that Settings > Theme offers the "Apply dark
+// theme to sites" checkbox. Upstream disables this, which hides the setting
+// entirely and leaves Blink's force-dark unreachable from the UI.
+//
+// This is the switch for Bare's auto-dark option and nothing more. It does not
+// close the white flash seen on navigation: that happens before the page
+// paints, and force-dark only changes how the page paints once it does.
+//
+// "opt_out" is false so the content setting still defaults to BLOCK: the
+// feature only makes the checkbox reachable, and darkening stays off until the
+// user ticks it. Upstream's true would have turned auto-dark on for everyone.
 BASE_FEATURE(kDarkenWebsitesCheckboxInThemesSetting,
-             base::FEATURE_DISABLED_BY_DEFAULT);
+             base::FEATURE_ENABLED_BY_DEFAULT);
 constexpr base::FeatureParam<bool> kDarkenWebsitesCheckboxOptOut{
-    &kDarkenWebsitesCheckboxInThemesSetting, "opt_out", true};
+    &kDarkenWebsitesCheckboxInThemesSetting, "opt_out", false};
 #endif  // BUILDFLAG(IS_ANDROID)
 
 namespace features {
