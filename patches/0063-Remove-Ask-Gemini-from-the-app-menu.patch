From 8edf46bf072048fe05c1e0dcf61cbc7675786956 Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Thu, 20 Aug 2026 06:39:39 +0000
Subject: [PATCH] Remove Ask Gemini from the app menu

GlicEnabling.isEnabledForProfile() answers true before the profile has settled,
so the entry appeared in the menu on the first launch after installing and
never again. A Google surface turning up exactly once, in a browser that has
none, is worse than showing it consistently.
---
 .../tabbed_mode/TabbedAppMenuPropertiesDelegate.java      | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
index e4548b2f1a..44df312983 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
@@ -1646,6 +1646,14 @@ public class TabbedAppMenuPropertiesDelegate extends AppMenuPropertiesDelegateIm
     }
 
     private @Nullable ListItem maybeBuildOpenGlicItem(@Nullable Tab currentTab) {
+        // De-Googled build: no Ask Gemini entry.
+        //
+        // GlicEnabling.isEnabledForProfile() answers true before the profile has settled, so the
+        // item appeared in the menu on the first launch after installing and never again, which
+        // is worse than showing it consistently: a Google surface turning up once, in a browser
+        // that has none.
+        if (true) return null;
+
         if (currentTab == null
                 || currentTab.isIncognito()
                 || currentTab.getWebContents() == null
