+/**
+ * Says how an action should be drawn, wherever it happens to be.
+ *
+ * <p>All three facts here used to be properties of a position. The bar inflated a list menu button
+ * in the first position and a plain image everywhere else, chose a binder per position, and let the
+ * layout name the inflated views. That was consistent only because each position did one thing
+ * forever. Once a position can hold any action, an action that needs a list menu has to get one
+ * wherever it lands, and an action that does not must not be handed the app menu's view class just
+ * because it was put on the right-hand end.
+ *
+ * <p>So each is answered from the action instead. The bar asks these three questions while it is
+ * being built, once per slot, and the position is not part of any of them.
+ */
+@NullMarked
+public final class BareToolbarActionRendering {
+    private BareToolbarActionRendering() {}
+
+    /**
+     * The view an action needs.
+     *
+     * <p>Home offers a menu on long press and needs a view that can show one. The app menu carries
+     * the update badge, which is a second view stacked on the button, so it needs the template that
+     * has one; without the badge it is an ordinary image like everything else. Every other action
+     * is an icon that responds to a press, which the generic template already is.
+     */
+    public static int templateForAction(@ActionId int actionId) {
+        if (actionId == ActionId.HOME_BUTTON) {
+            return R.layout.bottom_bar_list_menu_template;
+        }
+        if (actionId == ActionId.APP_MENU && BottomBarConfigUtils.shouldShowAppMenuUpdateBadge()) {
+            return R.layout.bottom_bar_app_menu_template;
+        }
+        return R.layout.bottom_bar_generic_template;
+    }
+
+    /**
+     * The binder an action is rendered through.
+     *
+     * <p>Follows the action rather than the position, so moving Home does not leave its long press
+     * behind and does not hand it to whatever took its place. The two general binders fall through
+     * to {@link ActionButtonBinder} for every property they do not handle themselves, so an action
+     * placed in a position that used to be special is drawn exactly as it would be anywhere else.
+     */
+    public static PropertyModelChangeProcessor.ViewBinder<PropertyModel, View, PropertyKey>
+            binderForAction(@ActionId int actionId) {
+        switch (actionId) {
+            case ActionId.HOME_BUTTON:
+                return HomeActionButtonBinder::bind;
+            case ActionId.APP_MENU:
+                return AppMenuActionButtonBinder::bind;
+            case ActionId.TAB_SWITCHER:
+                return TabSwitcherActionButtonBinder::bind;
+            case ActionId.GLIC:
+                return GlicActionButtonBinder::bind;
+            default:
+                return ActionButtonBinder::bind;
+        }
+    }
+
+    /**
+     * The id the inflated view should carry, or {@link View#NO_ID}.
+     *
+     * <p>The layout gives each stub an inflated id naming the action that used to live there, and
+     * code elsewhere in the browser looks two of them up across the whole activity rather than
+     * within the bar. Left alone, moving the app menu would leave its name on whichever button
+     * took its old position, and a search for the menu button would find, say, Share. Naming the
+     * view after the action it ended up holding keeps those searches finding the button they mean.
+     */
+    public static int viewIdForAction(@ActionId int actionId) {
+        switch (actionId) {
+            case ActionId.HOME_BUTTON:
+                return R.id.home_button;
+            case ActionId.APP_MENU:
+                return R.id.menu_button;
+            default:
+                return View.NO_ID;
+        }
+    }
+
+    /**
+     * The actions of the shared slot upstream ships, which are shown only where they apply.
+     *
+     * <p>Kept as a list because the question "is this one showable here" belongs to these three
+     * and to nothing else. Bare offers only the last of them, and offers it everywhere, but the
+     * question is still asked the same way.
+     */
+    public static final @ActionId int[] SHARED_SLOT_ACTIONS = {
+        ActionId.GLIC, ActionId.AI_MODE, ActionId.INCOGNITO,
+    };
+
+    /**
+     * Whether an action decides its own visibility rather than simply being shown.
+     *
+     * <p>Home is hidden when the homepage is turned off, and the shared slot's Google surfaces are
+     * shown only where they apply. Both are answered elsewhere and arrive later, so these start
+     * hidden and wait. Everything else is on the bar because the user put it there.
+     */
+    public static boolean hasManagedVisibility(@ActionId int actionId) {
+        return actionId == ActionId.HOME_BUTTON
+                || actionId == ActionId.GLIC
+                || actionId == ActionId.AI_MODE
+                || actionId == ActionId.INCOGNITO;
+    }
+}
