new file mode 100644
index 0000000000..67c49bb4a1
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareButtonDataActionAdapter.java
@@ -0,0 +1,162 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.view.View;
+import android.view.View.OnClickListener;
+
+import org.chromium.base.Callback;
+import org.chromium.base.lifetime.Destroyable;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ActivityTabProvider;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.toolbar.optional_button.ButtonData;
+import org.chromium.chrome.browser.toolbar.optional_button.ButtonData.ButtonSpec;
+import org.chromium.chrome.browser.toolbar.optional_button.ButtonDataProvider;
+import org.chromium.chrome.browser.ui.actions.ActionId;
+import org.chromium.chrome.browser.ui.actions.ActionProperties;
+import org.chromium.chrome.browser.ui.actions.ActionRegistry;
+import org.chromium.ui.modelutil.PropertyModel;
+
+/**
+ * Presents an existing toolbar {@link ButtonDataProvider} as a bottom bar action.
+ *
+ * <p>The optional button at the top of the screen and the buttons along the bottom describe
+ * themselves in different terms: one hands out {@link ButtonData} when asked, the other publishes a
+ * {@link PropertyModel} that surfaces observe. The two carry nearly the same facts, so rather than
+ * write a second Share or Translate that would drift from the first, this reads one and writes the
+ * other.
+ *
+ * <p>The provider is not owned here. It belongs to the adaptive toolbar, which built it and will
+ * destroy it; this only subscribes. Nothing about its behaviour, construction or lifetime changes
+ * by being read.
+ *
+ * <p>Providers hold the active tab as a plain supplier and do not watch it, leaving that to
+ * whoever is displaying the button, so the tab is observed here and the provider asked again
+ * whenever it changes.
+ */
+@NullMarked
+public class BareButtonDataActionAdapter
+        implements ButtonDataProvider.ButtonDataObserver, Destroyable {
+
+    private final @ActionId int mActionId;
+    private final ButtonDataProvider mProvider;
+    private final ActionRegistry mRegistry;
+    private final PropertyModel mModel;
+
+    /**
+     * Watches whichever tab is in front. Chromium's own observer for the activity tab, which moves
+     * itself as the front tab changes and also reports what happens inside that tab, so a provider
+     * whose answer depends on the page is asked again when the page changes.
+     */
+    private final ActivityTabProvider.ActivityTabTabObserver mTabObserver;
+
+    /** The tab the observer is currently reporting on. */
+    private @Nullable Tab mTab;
+
+    /** The provider's current click handling, refreshed with the rest of the model. */
+    private @Nullable OnClickListener mOnClick;
+
+    private boolean mDestroyed;
+
+    /**
+     * @param actionId The action this provider will appear as.
+     * @param provider The existing provider to read. Not owned.
+     * @param tabProvider The activity tab, observed so the provider can be re-asked.
+     * @param registry The registry to publish the model to.
+     */
+    public BareButtonDataActionAdapter(
+            @ActionId int actionId,
+            ButtonDataProvider provider,
+            ActivityTabProvider tabProvider,
+            ActionRegistry registry) {
+        mActionId = actionId;
+        mProvider = provider;
+        mRegistry = registry;
+        mModel = new PropertyModel.Builder(ActionProperties.BASE_KEYS).build();
+
+        mProvider.addObserver(this);
+
+        // Built last of the three, and after the model exists. Asking to be told about the tab
+        // that is already in front means the callback arrives from inside this constructor, so
+        // anything it touches has to be ready before the observer is made.
+        mTabObserver =
+                new ActivityTabProvider.ActivityTabTabObserver(
+                        tabProvider, /* shouldTrigger= */ true) {
+                    @Override
+                    protected void onObservingDifferentTab(@Nullable Tab tab) {
+                        mTab = tab;
+                        refresh();
+                    }
+                };
+
+        mRegistry.register(mActionId, mModel);
+    }
+
+    /** The provider notified that something about the button changed. */
+    @Override
+    public void buttonDataChanged(boolean canShowHint) {
+        refresh();
+    }
+
+    /**
+     * Asks the provider about the current tab and copies the answer into the model.
+     *
+     * <p>An action that cannot run right now keeps its place and stops responding rather than
+     * disappearing. A button that moves or vanishes under the finger is worse than one that is
+     * plainly unavailable, and a slot the user chose should stay where they put it. Leaving the
+     * press callback null is what expresses that: the binder reads the absent callback as nothing
+     * to press and disables the view, which draws it in the disabled tint.
+     */
+    private void refresh() {
+        if (mDestroyed) return;
+
+        @Nullable ButtonData data = mProvider.get(mTab);
+        if (data == null) {
+            mOnClick = null;
+            mModel.set(ActionProperties.ON_PRESS_CALLBACK, null);
+            return;
+        }
+
+        ButtonSpec spec = data.getButtonSpec();
+
+        mModel.set(ActionProperties.ICON_DRAWABLE, spec.getDrawable());
+        mModel.set(
+                ActionProperties.CONTENT_DESCRIPTION_RESOLVER,
+                context -> spec.getContentDescription());
+        mModel.set(ActionProperties.IS_SELECTED, spec.isSelected() || spec.isChecked());
+
+        mOnClick = spec.getOnClickListener();
+        boolean usable = data.canShow() && data.isEnabled() && mOnClick != null;
+        // BUTTON_STATE is deliberately not set: it is not one of BASE_KEYS, and the binder
+        // already reads an absent state as the default one. Whether the button responds is
+        // carried by the press callback alone, which the binder turns into the enabled state.
+        mModel.set(
+                ActionProperties.ON_PRESS_CALLBACK,
+                usable ? (Callback<View>) this::onPress : null);
+    }
+
+    /**
+     * Runs the provider's own click handling.
+     *
+     * <p>Kept as its own method so that a later patch can offer the same action as the long press
+     * of a different slot without a second copy of what pressing it means.
+     */
+    private void onPress(View view) {
+        if (mOnClick != null) mOnClick.onClick(view);
+    }
+
+    @Override
+    public void destroy() {
+        if (mDestroyed) return;
+        mDestroyed = true;
+        mOnClick = null;
+        mTab = null;
+        mProvider.removeObserver(this);
+        mTabObserver.destroy();
+        mRegistry.unregister(mActionId);
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/bare/BareToolbarActionCatalogue.java b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareToolbarActionCatalogue.java
new file mode 100644
