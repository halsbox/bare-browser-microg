From 5ef4fa2710b8f25834e12140f769fbbe324f7a4d Mon Sep 17 00:00:00 2001
From: Bare <git@barebrowser.org>
Date: Thu, 10 Sep 2026 04:04:25 +0000
Subject: [PATCH] Put two annotations and a javadoc back on what they describe

Both patches inserted a declaration immediately after an existing javadoc rather
than after the method it belonged to.

In LogoMediator the insertion landed between @VisibleForTesting and
getDefaultGoogleLogoDrawable, so the annotation moved onto the private helper
and the method that is reached from tests lost it. In PwaRestorePromoUtils the
upstream javadoc for launchPromoIfNeeded, @param and @return included, ended up
introducing a boolean constant.

Only the order changes. No behaviour depends on either.
---
 .../browser/webapps/PwaRestorePromoUtils.java    | 16 ++++++++--------
 .../chrome/browser/logo/LogoMediator.java        | 12 ++++++------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/webapps/PwaRestorePromoUtils.java b/chrome/android/java/src/org/chromium/chrome/browser/webapps/PwaRestorePromoUtils.java
index 8579570051..0b70b90d1b 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/webapps/PwaRestorePromoUtils.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/webapps/PwaRestorePromoUtils.java
@@ -75,6 +75,14 @@ public class PwaRestorePromoUtils {
         return false;
     }
 
+    /**
+     * De-Googled build: the web app restore promo is never offered.
+     *
+     * <p>The sheet restores apps "used on devices connected to this account", so it depends on a
+     * signed-in Google account and can never have anything to offer in this build.
+     */
+    private static final boolean SHOW_PWA_RESTORE_PROMO = false;
+
     /**
      * Launch the PWA Restore promotion, if we've determined that this launch meets the criteria for
      * for showing it. The promo is intended to show as soon as possible after the user has switched
@@ -85,14 +93,6 @@ public class PwaRestorePromoUtils {
      * @param windowAndroid The current {@link WindowAndroid} to use for this promo.
      * @return Whether the PWA Restore promo was shown.
      */
-    /**
-     * De-Googled build: the web app restore promo is never offered.
-     *
-     * <p>The sheet restores apps "used on devices connected to this account", so it depends on a
-     * signed-in Google account and can never have anything to offer in this build.
-     */
-    private static final boolean SHOW_PWA_RESTORE_PROMO = false;
-
     public static boolean launchPromoIfNeeded(Profile profile, WindowAndroid windowAndroid) {
         if (!SHOW_PWA_RESTORE_PROMO) {
             return false;
